doctype html
html
  head
    title Thông báo tiêm chủng
    style.
      .container {
        background-color: #f9f9f9;
        padding: 30px;
        border-radius: 10px;
        max-width: 600px;
        margin: 0 auto;
        font-family: Arial, sans-serif;
        color: #2c3e50;
      }
      .header {
        background-color: #2c3e50;
        color: white;
        padding: 15px;
        text-align: center;
        border-radius: 10px 10px 0 0;
        font-size: 20px;
        font-weight: bold;
      }
      .content {
        padding: 20px;
        background-color: white;
        border-radius: 0 0 10px 10px;
        line-height: 1.6;
      }
      .footer {
        margin-top: 30px;
        font-style: italic;
        text-align: center;
        font-size: 14px;
        color: #777;
      }
  body
    .container
      .header #{title}
      .content
        if role === 'Phụ huynh'
            p Kính gửi #{role} #{fullname},
        else
            p Gửi em  #{fullname},

        pre(style="white-space: pre-line; font-family: inherit; margin-top: 10px;") #{body}

        p(style="margin-top: 20px")
          | 📅 Ngày tiêm dự kiến: 
          strong #{scheduledAt}
        
        if role === 'Phụ huynh'
            p Phụ huynh vui lòng truy cập trang web để đồng ý hoặc từ chối tiêm chủng cho học sinh.
        else 
            p Các em nhắc nhở phụ huynh truy cập trang web để đồng ý hoặc từ chối tiêm chủng.
          

        p(style="margin-top: 30px") Trân trọng,
        p Ban giám hiệu nhà trường

      .footer
        | Email được gửi từ hệ thống quản lý y tế học đường - Trường THCS Trần Hưng Đạo.
