generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id        Int       @id @default(autoincrement())
  fullname  String
  email     String    @unique
  password  String
  status    String    @default("ACTIVE")
  roleID    Int
  createdAt DateTime? @default(now()) @db.Timestamptz(3)
  createdBy Int?
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)
  updatedBy Int?
  role      Role      @relation(fields: [roleID], references: [id])
  Parent    Parent?
  Student   Student?
}

model Role {
  id    Int       @id @default(autoincrement())
  name  String    @unique
  users Account[]
}

model Student {
  id                  Int                      @id @default(autoincrement())
  student_code        String                   @unique
  dateOfBirth         DateTime
  gender              String
  graduated           Boolean                  @default(false)
  createdAt           DateTime?                @default(now()) @db.Timestamptz(3)
  createdBy           Int?
  updatedAt           DateTime?                @updatedAt @db.Timestamptz(3)
  updatedBy           Int?
  accountID           Int                      @unique
  account             Account                  @relation(fields: [accountID], references: [id])
  parentId            Int?
  Parent              Parent?                  @relation(fields: [parentId], references: [id])
  parentInfoID        Int
  ParentInfo          ParentInfo               @relation(fields: [parentInfoID], references: [id])
  classAssignments    StudentClassAssignment[]
  vaccinationResponse VaccinationResponse[]
  vaccinationResult   VaccinationResult[]
  healthProfile       HealthProfile?
}

model Class {
  id                 Int                      @id @default(autoincrement())
  name               String                   @unique
  grade              Int
  createdAt          DateTime?                @default(now()) @db.Timestamptz(3)
  studentAssignments StudentClassAssignment[]
}

model StudentClassAssignment {
  id             Int @id @default(autoincrement())
  studentID      Int
  academicYearID Int
  classID        Int

  student      Student      @relation(fields: [studentID], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearID], references: [id])
  class        Class        @relation(fields: [classID], references: [id])

  createdAt DateTime? @default(now()) @db.Timestamptz(3)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)

  @@unique([studentID, academicYearID])
}

model AcademicYear {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  startDate DateTime
  endDate   DateTime
  createdAt DateTime? @default(now()) @db.Timestamptz(3)
  createdBy Int?
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)
  updatedBy Int?

  studentAssignments StudentClassAssignment[]
  VaccinationEvent   VaccinationEvent[]
}

model ParentInfo {
  id           Int       @id @default(autoincrement())
  fullname     String
  email        String    @unique
  phone        String
  isRegistered Boolean   @default(false)
  createdAt    DateTime? @default(now()) @db.Timestamptz(3)
  createdBy    Int?
  student      Student[]
}

model HealthProfile {
  id Int @id @default(autoincrement())

  height                String
  weight                String
  bloodGroup            String
  treatmentHistory      String?
  additionalNote        String?
  hasNoAllergies        Boolean                 @default(false)
  healthAllergies       HealthAllergies[]
  detailAllergies       String?
  methodAllergies       String?
  hasNochronicDiseases  Boolean                 @default(false)
  healthChronicDiseases HealthChronicDiseases[]
  detailChronicDiseases String?
  methodChronicDiseases String?
  medicationNote        String?
  visionLeft            String?
  visionRight           String?
  wearGlasses           Boolean                 @default(false)
  noteVision            String?

  hearingLeft  String?
  hearingRight String?
  hearingAid   Boolean @default(false)
  noteHearing  String?

  healthVaccination  HealthVaccination[]
  vaccinationHistory String?
  sideEffect         Boolean             @default(false)
  DetailSideEffect   String?

  studentID Int     @unique
  student   Student @relation(fields: [studentID], references: [id])

  createdAt DateTime? @default(now()) @db.Timestamptz(3)
  createdBy Int?
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)
  updatedBy Int?
}

model HealthVaccination {
  id              Int           @id @default(autoincrement())
  healthProfileID Int
  vaccinationID   Int
  healthProfile   HealthProfile @relation(fields: [healthProfileID], references: [id])
  vaccination     Vaccination   @relation(fields: [vaccinationID], references: [id])

  createdAt DateTime? @default(now()) @db.Timestamptz(3)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)

  @@unique([healthProfileID, vaccinationID])
}

model Vaccination {
  id                Int                 @id @default(autoincrement())
  name              String
  healthVaccination HealthVaccination[]
}

model Allergies {
  id              Int               @id @default(autoincrement())
  name            String            @unique
  healthAllergies HealthAllergies[]
}

model ChronicDiseases {
  id                    Int                     @id @default(autoincrement())
  name                  String                  @unique
  HealthChronicDiseases HealthChronicDiseases[]
}

model HealthAllergies {
  id              Int @id @default(autoincrement())
  healthProfileID Int
  allergiesID     Int

  healthProfile HealthProfile @relation(fields: [healthProfileID], references: [id])
  allergies     Allergies     @relation(fields: [allergiesID], references: [id])

  createdAt DateTime? @default(now()) @db.Timestamptz(3)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)

  @@unique([healthProfileID, allergiesID])
}

model HealthChronicDiseases {
  id                Int @id @default(autoincrement())
  healthProfileID   Int
  chronicDiseasesID Int

  healthProfile   HealthProfile   @relation(fields: [healthProfileID], references: [id])
  chronicDiseases ChronicDiseases @relation(fields: [chronicDiseasesID], references: [id])

  createdAt DateTime? @default(now()) @db.Timestamptz(3)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)

  @@unique([healthProfileID, chronicDiseasesID])
}

model Parent {
  id        Int       @id @default(autoincrement())
  fullname  String
  email     String    @unique
  phone     String
  accountID Int       @unique
  createdAt DateTime? @default(now()) @db.Timestamptz(3)
  createdBy Int?
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)
  updatedBy Int?
  account   Account   @relation(fields: [accountID], references: [id])
  student   Student[]
}

enum EventStatus {
  DRAFT
  CONFIRMED
  SUCCESSED
}

model VaccinationEvent {
  id              Int          @id @default(autoincrement())
  name            String
  description     String
  scheduledAt     DateTime
  status          EventStatus  @default(DRAFT)
  customMailTitle String?
  customMailBody  String?
  academicYearID  Int
  academicYear    AcademicYear @relation(fields: [academicYearID], references: [id])
  createdAt       DateTime?    @default(now()) @db.Timestamptz(3)
  createdBy       Int?
  updatedAt       DateTime?    @updatedAt @db.Timestamptz(3)
  updatedBy       Int?

  targets             VaccinationTarget[]
  vaccinationResponse VaccinationResponse[]
  vaccinationResult   VaccinationResult[]
}

model VaccinationTarget {
  id                 Int              @id @default(autoincrement())
  vaccinationEventID Int
  targetType         TargetType
  targetID           Int
  vaccinationEvent   VaccinationEvent @relation(fields: [vaccinationEventID], references: [id])
}

model VaccinationResponse {
  id                 Int            @id @default(autoincrement())
  vaccinationEventID Int
  studentID          Int
  status             ResponseStatus @default(PENDING)
  note               String?
  respondedAt        DateTime?

  vaccinationEvent VaccinationEvent @relation(fields: [vaccinationEventID], references: [id])
  student          Student          @relation(fields: [studentID], references: [id])
}

model VaccinationResult {
  id                 Int             @id @default(autoincrement())
  vaccinationEventID Int
  studentID          Int
  status             InjectionStatus
  result             InjectionResult
  note               String?
  isSend             Boolean         @default(false)
  createdAt          DateTime?       @default(now()) @db.Timestamptz(3)
  createdBy          Int?
  updatedAt          DateTime?       @updatedAt @db.Timestamptz(3)
  updatedBy          Int?

  vaccinationEvent VaccinationEvent @relation(fields: [vaccinationEventID], references: [id])
  student          Student          @relation(fields: [studentID], references: [id])

  @@unique([vaccinationEventID, studentID])
}

enum ResponseStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum TargetType {
  SCHOOL
  GRADE
  CLASS
}

enum InjectionResult {
  GOOD
  BAD
  NOT_EVALUATED
}

enum InjectionStatus {
  SUCCESS
  SKIPPED
}
