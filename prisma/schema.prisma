generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id        Int       @id @default(autoincrement())
  fullname  String
  email     String    @unique
  password  String
  status    String    @default("ACTIVE")
  roleID    Int
  createdAt DateTime? @default(now()) @db.Timestamptz(3)
  createdBy Int?
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)
  updatedBy Int?
  role      Role      @relation(fields: [roleID], references: [id])
  Parent    Parent?
  Student   Student?
}

model Role {
  id    Int       @id @default(autoincrement())
  name  String    @unique
  users Account[]
}

model Student {
  id                  Int                      @id @default(autoincrement())
  student_code        String                   @unique
  dateOfBirth         DateTime
  gender              String
  graduated           Boolean                  @default(false)
  createdAt           DateTime?                @default(now()) @db.Timestamptz(3)
  createdBy           Int?
  updatedAt           DateTime?                @updatedAt @db.Timestamptz(3)
  updatedBy           Int?
  accountID           Int                      @unique
  account             Account                  @relation(fields: [accountID], references: [id])
  parentId            Int?
  Parent              Parent?                  @relation(fields: [parentId], references: [id])
  parentInfoID        Int
  ParentInfo          ParentInfo               @relation(fields: [parentInfoID], references: [id])
  classAssignments    StudentClassAssignment[]
  vaccinationResponse VaccinationResponse[]
  vaccinationResult   VaccinationResult[]
  healthProfile       HealthProfile?
  MedicalEvent        MedicalEvent[]
  MedicineRequest     MedicineRequest[]
}

model Class {
  id                 Int                      @id @default(autoincrement())
  name               String                   @unique
  grade              Int
  createdAt          DateTime?                @default(now()) @db.Timestamptz(3)
  studentAssignments StudentClassAssignment[]
}

model StudentClassAssignment {
  id             Int @id @default(autoincrement())
  studentID      Int
  academicYearID Int
  classID        Int

  student      Student      @relation(fields: [studentID], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearID], references: [id])
  class        Class        @relation(fields: [classID], references: [id])

  createdAt DateTime? @default(now()) @db.Timestamptz(3)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)

  @@unique([studentID, academicYearID])
}

model AcademicYear {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  startDate DateTime
  endDate   DateTime
  createdAt DateTime? @default(now()) @db.Timestamptz(3)
  createdBy Int?
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)
  updatedBy Int?

  studentAssignments StudentClassAssignment[]
  VaccinationEvent   VaccinationEvent[]
}

model ParentInfo {
  id           Int       @id @default(autoincrement())
  fullname     String
  email        String    @unique
  phone        String
  isRegistered Boolean   @default(false)
  createdAt    DateTime? @default(now()) @db.Timestamptz(3)
  createdBy    Int?
  student      Student[]
}

model HealthProfile {
  id Int @id @default(autoincrement())

  height                String
  weight                String
  bloodGroup            String
  treatmentHistory      String?
  additionalNote        String?
  hasNoAllergies        Boolean                 @default(false)
  healthAllergies       HealthAllergies[]
  detailAllergies       String?
  methodAllergies       String?
  hasNochronicDiseases  Boolean                 @default(false)
  healthChronicDiseases HealthChronicDiseases[]
  detailChronicDiseases String?
  methodChronicDiseases String?
  medicationNote        String?
  visionLeft            String?
  visionRight           String?
  wearGlasses           Boolean                 @default(false)
  noteVision            String?

  hearingLeft  String?
  hearingRight String?
  hearingAid   Boolean @default(false)
  noteHearing  String?

  healthVaccination  HealthVaccination[]
  vaccinationHistory String?
  sideEffect         Boolean             @default(false)
  DetailSideEffect   String?

  studentID Int     @unique
  student   Student @relation(fields: [studentID], references: [id])

  createdAt DateTime? @default(now()) @db.Timestamptz(3)
  createdBy Int?
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)
  updatedBy Int?
}

model HealthVaccination {
  id              Int           @id @default(autoincrement())
  healthProfileID Int
  vaccinationID   Int
  healthProfile   HealthProfile @relation(fields: [healthProfileID], references: [id])
  vaccination     Vaccination   @relation(fields: [vaccinationID], references: [id])

  createdAt DateTime? @default(now()) @db.Timestamptz(3)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)

  @@unique([healthProfileID, vaccinationID])
}

model Vaccination {
  id                Int                 @id @default(autoincrement())
  name              String
  healthVaccination HealthVaccination[]
}

model Allergies {
  id              Int               @id @default(autoincrement())
  name            String            @unique
  healthAllergies HealthAllergies[]
}

model ChronicDiseases {
  id                    Int                     @id @default(autoincrement())
  name                  String                  @unique
  HealthChronicDiseases HealthChronicDiseases[]
}

model HealthAllergies {
  id              Int @id @default(autoincrement())
  healthProfileID Int
  allergiesID     Int

  healthProfile HealthProfile @relation(fields: [healthProfileID], references: [id])
  allergies     Allergies     @relation(fields: [allergiesID], references: [id])

  createdAt DateTime? @default(now()) @db.Timestamptz(3)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)

  @@unique([healthProfileID, allergiesID])
}

model HealthChronicDiseases {
  id                Int @id @default(autoincrement())
  healthProfileID   Int
  chronicDiseasesID Int

  healthProfile   HealthProfile   @relation(fields: [healthProfileID], references: [id])
  chronicDiseases ChronicDiseases @relation(fields: [chronicDiseasesID], references: [id])

  createdAt DateTime? @default(now()) @db.Timestamptz(3)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)

  @@unique([healthProfileID, chronicDiseasesID])
}

model Parent {
  id              Int               @id @default(autoincrement())
  fullname        String
  email           String            @unique
  phone           String
  accountID       Int               @unique
  createdAt       DateTime?         @default(now()) @db.Timestamptz(3)
  createdBy       Int?
  updatedAt       DateTime?         @updatedAt @db.Timestamptz(3)
  updatedBy       Int?
  account         Account           @relation(fields: [accountID], references: [id])
  student         Student[]
  MedicineRequest MedicineRequest[]
}

enum EventStatus {
  DRAFT
  CONFIRMED
  SUCCESSED
}

model VaccinationEvent {
  id              Int          @id @default(autoincrement())
  name            String
  description     String
  scheduledAt     DateTime
  status          EventStatus  @default(DRAFT)
  customMailTitle String?
  customMailBody  String?
  academicYearID  Int
  academicYear    AcademicYear @relation(fields: [academicYearID], references: [id])
  createdAt       DateTime?    @default(now()) @db.Timestamptz(3)
  createdBy       Int?
  updatedAt       DateTime?    @updatedAt @db.Timestamptz(3)
  updatedBy       Int?

  targets             VaccinationTarget[]
  vaccinationResponse VaccinationResponse[]
  vaccinationResult   VaccinationResult[]
  VaccineStock        VaccineEventStock[]
}

model VaccineEventStock {
  id                 Int              @id @default(autoincrement())
  vaccinationEventID Int
  medicineID         Int?
  medicineSupplyID   Int?
  quantityPlanned    Int
  quantityUsed       Int              @default(0)
  notes              String?
  vaccinationEvent   VaccinationEvent @relation(fields: [vaccinationEventID], references: [id])
  medicine           Medicine?        @relation(fields: [medicineID], references: [id])
  medicineSupply     MedicineSupply?  @relation(fields: [medicineSupplyID], references: [id])
}

model VaccinationTarget {
  id                 Int              @id @default(autoincrement())
  vaccinationEventID Int
  targetType         TargetType
  targetID           Int
  vaccinationEvent   VaccinationEvent @relation(fields: [vaccinationEventID], references: [id])
}

model VaccinationResponse {
  id                 Int            @id @default(autoincrement())
  vaccinationEventID Int
  studentID          Int
  status             ResponseStatus @default(PENDING)
  note               String?
  respondedAt        DateTime?

  vaccinationEvent VaccinationEvent @relation(fields: [vaccinationEventID], references: [id])
  student          Student          @relation(fields: [studentID], references: [id])
}

model VaccinationResult {
  id                 Int             @id @default(autoincrement())
  vaccinationEventID Int
  studentID          Int
  status             InjectionStatus
  result             InjectionResult
  note               String?
  isSend             Boolean         @default(false)
  createdAt          DateTime?       @default(now()) @db.Timestamptz(3)
  createdBy          Int?
  updatedAt          DateTime?       @updatedAt @db.Timestamptz(3)
  updatedBy          Int?

  vaccinationEvent VaccinationEvent @relation(fields: [vaccinationEventID], references: [id])
  student          Student          @relation(fields: [studentID], references: [id])

  @@unique([vaccinationEventID, studentID])
}

enum ResponseStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum TargetType {
  SCHOOL
  GRADE
  CLASS
}

enum InjectionResult {
  GOOD
  BAD
  NOT_EVALUATED
}

enum InjectionStatus {
  SUCCESS
  SKIPPED
}

model Medicine {
  id                Int                 @id @default(autoincrement())
  name              String
  image             String
  description       String?
  stock             Int
  type              MedicineType
  usage             String?
  classifyID        Int
  classify          MedicineClassify    @relation(fields: [classifyID], references: [id])
  createdAt         DateTime?           @default(now()) @db.Timestamptz(3)
  createdBy         Int?
  updatedAt         DateTime?           @updatedAt @db.Timestamptz(3)
  updatedBy         Int?
  RequestItem       RequestItem[]
  VaccineEventStock VaccineEventStock[]
  Treatment         Treatment[]
}

model MedicineClassify {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  createdAt DateTime?  @default(now()) @db.Timestamptz(3)
  createdBy Int?
  updatedAt DateTime?  @updatedAt @db.Timestamptz(3)
  updatedBy Int?
  medicines Medicine[]
}

model MedicineSupply {
  id                Int                 @id @default(autoincrement())
  image             String
  name              String
  description       String?
  stock             Int
  usage             String?
  category          String?
  createdAt         DateTime?           @default(now()) @db.Timestamptz(3)
  createdBy         Int?
  updatedAt         DateTime?           @updatedAt @db.Timestamptz(3)
  updatedBy         Int?
  RequestItem       RequestItem[]
  VaccineEventStock VaccineEventStock[]
  Treatment         Treatment[]
}

enum MedicineType {
  PELLETS
  BOTTLE
  JAR
}

model MedicineSupplyRequest {
  id        Int           @id @default(autoincrement())
  note      String?
  status    RequestStatus @default(PENDING)
  createdAt DateTime      @default(now())
  createdBy Int?
  items     RequestItem[]
}

model RequestItem {
  id               Int          @id @default(autoincrement())
  requestId        Int
  medicineID       Int?
  medicineSupplyID Int?
  quantity         Int
  urgency          UrgencyLevel @default(NORMAL)
  note             String?

  request        MedicineSupplyRequest @relation(fields: [requestId], references: [id])
  medicine       Medicine?             @relation(fields: [medicineID], references: [id])
  medicineSupply MedicineSupply?       @relation(fields: [medicineSupplyID], references: [id])

  // @@check("medicineId IS NOT NULL OR medicalSupplyId IS NOT NULL")
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UrgencyLevel {
  NORMAL
  URGENT
}

model MedicalEvent {
  id               Int                  @id @default(autoincrement())
  studentID        Int
  type             String
  occurredAt       DateTime
  description      String
  status           MedicalEventStatus   @default(PENDING)
  severity         MedicalEventSeverity @default(NORMAL)
  isSend           Boolean              @default(false)
  student          Student              @relation(fields: [studentID], references: [id])
  createdBy        Int?
  updatedAt        DateTime?            @updatedAt @db.Timestamptz(3)
  updatedBy        Int?
  HospitalTransfer HospitalTransfer?
  Treatment        Treatment[]
}

model Treatment {
  id               Int             @id @default(autoincrement())
  medicalEventID   Int
  medicineID       Int?
  medicineSupplyID Int?
  medical          MedicalEvent    @relation(fields: [medicalEventID], references: [id])
  medicine         Medicine?       @relation(fields: [medicineID], references: [id])
  medicineSupply   MedicineSupply? @relation(fields: [medicineSupplyID], references: [id])
  quantity         Int
  dosage           String?
  createdAt        DateTime?       @default(now()) @db.Timestamptz(3)
  createdBy        Int?
  updatedAt        DateTime?       @updatedAt @db.Timestamptz(3)
  updatedBy        Int?
}

enum MedicalEventStatus {
  PENDING
  PROCESSING
  HOSPITALIZED
  HOSPITALDISCHARGE
  COMPLETED
}

enum MedicalEventSeverity {
  NORMAL
  HOSPITAL
}

model HospitalTransfer {
  id             Int          @id @default(autoincrement())
  medicalEventID Int          @unique
  hospitalName   String
  transferredAt  DateTime     @db.Timestamptz(3)
  MedicalEvent   MedicalEvent @relation(fields: [medicalEventID], references: [id])
  createdBy      Int?
  updatedAt      DateTime?    @updatedAt @db.Timestamptz(3)
  updatedBy      Int?
}

enum MedicineRequestStatus {
  PENDING // Phụ huynh mới gửi, chờ xác nhận
  CONFIRMED // Y tá đã xác nhận
  COMPLETED // Hết thời gian uống thuốc
  REJECTED // Y tá từ chối
}

model MedicineRequest {
  id                  Int                   @id @default(autoincrement())
  studentID           Int
  parentID            Int
  note                String?
  status              MedicineRequestStatus @default(PENDING)
  student             Student               @relation(fields: [studentID], references: [id])
  parent              Parent                @relation(fields: [parentID], references: [id])
  createdAt           DateTime?             @default(now()) @db.Timestamptz(3)
  confirmedAt         DateTime?             @db.Timestamptz(3)
  createdBy           Int?
  updatedAt           DateTime?             @updatedAt @db.Timestamptz(3)
  updatedBy           Int?
  MedicineRequestItem MedicineRequestItem[]
}

model MedicineRequestItem {
  id              Int             @id @default(autoincrement())
  requestID       Int
  medicineName    String
  quantitySent    Int
  dosage          String
  usageTimes      String[]
  startDate       DateTime
  endDate         DateTime
  MedicineRequest MedicineRequest @relation(fields: [requestID], references: [id])
}
