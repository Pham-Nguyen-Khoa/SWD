generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id        Int       @id @default(autoincrement())
  fullname  String
  email     String    @unique
  password  String
  status    String    @default("ACTIVE")
  roleID    Int
  createdAt DateTime? @default(now()) @db.Timestamptz(3)
  createdBy Int?
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)
  updatedBy Int?
  role      Role      @relation(fields: [roleID], references: [id])
  Parent    Parent?
  Student   Student?
}

model Role {
  id    Int       @id @default(autoincrement())
  name  String    @unique
  users Account[]
}

model Student {
  id           Int        @id @default(autoincrement())
  student_code String    @unique
  dateOfBirth  DateTime
  class        String
  gender       String
  accountID    Int        @unique
  parentId     Int?
  createdAt    DateTime?  @default(now()) @db.Timestamptz(3)
  createdBy    Int?
  updatedAt    DateTime?  @updatedAt @db.Timestamptz(3)
  updatedBy    Int?
  parentInfoID Int
  account      Account    @relation(fields: [accountID], references: [id])
  Parent       Parent?    @relation(fields: [parentId], references: [id])
  ParentInfo   ParentInfo @relation(fields: [parentInfoID], references: [id])
}

model ParentInfo {
  id           Int       @id @default(autoincrement())
  fullname     String
  email        String    @unique
  phone        String
  isRegistered Boolean   @default(false)
  createdAt    DateTime? @default(now()) @db.Timestamptz(3)
  createdBy    Int?
  student      Student[]
}

model Parent {
  id        Int       @id @default(autoincrement())
  fullname  String
  email     String    @unique
  phone     String
  accountID Int       @unique
  createdAt DateTime? @default(now()) @db.Timestamptz(3)
  createdBy Int?
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)
  updatedBy Int?
  account   Account   @relation(fields: [accountID], references: [id])
  student   Student[]
}
